# KEP Brain configuration. Copy to .env and fill in. Empty values count as unset. Never commit .env.

# --- Process ---
ENV=dev                      # dev | test | prod
LOG_LEVEL=INFO
LOG_FORMAT=console           # console | json
API_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000   # comma-separated allowed browser origins
SERVICE_NAME=kep-brain-api
PUBLIC_BASE_URL=http://localhost:3000   # public origin; the web uses it for absolute links (sitemap, Open Graph)

# --- FalkorDB ---
FALKORDB_HOST=localhost              # compose overrides this to the falkordb service
FALKORDB_PORT=6380                   # host port of the dev container
FALKORDB_PASSWORD=                   # REQUIRED: choose a long random password
FALKORDB_TIMEOUT_SECONDS=5
FALKORDB_ACL_MODE=single             # single (one password) | aclfile (per-role users)
FALKORDB_READER_PASSWORD=            # aclfile mode only
FALKORDB_MEMORY_PASSWORD=            # aclfile mode only
FALKORDB_OPS_PASSWORD=               # aclfile mode only
FALKORDB_WRITER_PASSWORD=            # aclfile mode only
FALKORDB_IMAGE=falkordb/falkordb:v4.22.0   # echoed by GET /v1/meta

# --- Data sources ---
# Nothing needs to exist on disk: the first run clones the public repositories into REPO_CACHE_DIR and every
# later run fetches them, so new KEPs are picked up on the next sync.
ENHANCEMENTS_REPO_URL=https://github.com/kubernetes/enhancements.git
COMMUNITY_REPO_URL=https://github.com/kubernetes/community.git
OWNERS_REPO_URL=https://github.com/kubernetes/kubernetes.git   # read through the GitHub API, never cloned
# Optional pins for a reproducible snapshot. Empty = the default-branch head at the start of each sync.
ENHANCEMENTS_PIN_SHA=
COMMUNITY_PIN_SHA=
OWNERS_PIN_SHA=
GIT_TIMEOUT_SECONDS=600              # per git clone/fetch step (clone gets three times this)
REPO_CACHE_DIR=./repo_cache          # where the worker keeps its git clones
SIGS=sig-node,sig-scheduling,sig-apps   # SIG directories in scope
TICKETS_AS_OF=                       # ISO timestamp the ticket data is current to (shown in /v1/meta)
# REQUIRED by `worker all`: sync-owners and sync-tickets read the GitHub API and fail without a token
# (a classic token with no scopes is enough; only public data is read).
GITHUB_TOKEN=
# Disk cache of GitHub GraphQL responses: auto = record in dev/test, off in prod. Delete the cache dir to refresh.
GITHUB_CACHE=auto                    # auto | off | record | replay

# --- LLM ---
LLM_PROVIDER=openai_compatible       # the only adapter: any OpenAI-compatible chat completions endpoint
LLM_MODEL=openai/gpt-oss-120b
LLM_MODEL_CHEAP=openai/gpt-oss-20b
LLM_FALLBACK_MODELS=qwen/qwen3.8-27b # tried in order when the primary model answers 429/503 (comma-separated)
OPENAI_API_KEY=                      # Groq API key for the OpenAI-compatible endpoint
OPENAI_BASE_URL=https://api.groq.com/openai/v1
LLM_DAILY_BUDGET_USD=5
LLM_TIMEOUT_SECONDS=60
LLM_REQUESTS_PER_MINUTE=25           # client-side request pacing for Groq's rate-limited free tier
LLM_MAX_RETRIES=4                    # retries on rate limits and server errors
FINDINGS_AGENT_ENABLED=true
FINDINGS_AGENT_DAILY_USD=1

# --- API limits, access and MCP ---
ASK_RATE_LIMIT_PER_10M=30
# Global cap on LLM asks per UTC day (protects the free-tier token budget).
ASK_DAILY_CAP=150
TOOLS_RATE_LIMIT_PER_10M=300         # direct POST /v1/tools/{name} calls per client address per 10 minutes
# Honour X-Forwarded-For only behind a trusted reverse proxy (true in the prod compose).
TRUST_PROXY=false
MAX_BODY_BYTES=65536
ADMIN_TOKEN=                         # protects admin endpoints; at least 32 random bytes
MCP_TOKEN=                           # bearer token for the MCP server; at least 32 random bytes
MCP_PORT=8765
